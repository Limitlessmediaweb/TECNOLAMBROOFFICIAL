# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.swc-cache
/lighthouse
.env.local

# artefatti locali di verifica e configurazione dell'ambiente di lavoro
/screenshots
/.claude
!.env.example

# spot video: file pesanti (si rigenerano con gli script)
/video-tiktok/*/riprese/
/video-tiktok/*/stock/*.mp4
/video-tiktok/*/stock/frames/
/video-tiktok/*/render/
/video-tiktok/*/overlays/
/video-tiktok/*/out/
/video-tiktok/*/node_modules/
/video-tiktok/*/3d/assets/*.hdr

# output dei test locali
/test-output/

# spot 3D: fotogrammi e video si rigenerano con gli script (video/spot-3d/README.md)
/video/*/node_modules/
/video/*/render/
/video/*/out/
/video/*/assets/*.hdr
/video/*/scenes/part3d.bundle.js
/video/*/out-build-log.txt
