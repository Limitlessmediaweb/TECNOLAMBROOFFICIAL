# URL pubblico del sito (canonical, sitemap, Open Graph). Senza "/" finale.
NEXT_PUBLIC_SITE_URL=https://www.tecnolambro.com

# false = noindex globale e robots.txt chiuso. Mettere a true SOLO al lancio.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Dominio registrato su Plausible (es. tecnolambro.com). Vuoto = nessuno script analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Credito nel footer.
NEXT_PUBLIC_LIMITLESS_URL=https://www.limitlessmedia.it

# true = badge "Versione demo" e segnaposto [DA COMPLETARE] evidenziati in giallo.
NEXT_PUBLIC_DEMO=true

# ---- Richieste di preventivo (app/api/quote/route.ts). Solo lato server: niente NEXT_PUBLIC_.
# Casella che riceve le richieste.
QUOTE_TO_EMAIL=riccardo.pasquini2k8@gmail.com
# Mittente delle email (con Resend: un indirizzo del dominio verificato, es. "Tecnolambro <preventivi@tecnolambro.com>").
QUOTE_FROM_EMAIL=
# 1) Resend (consigliato): chiave API da resend.com → API Keys.
RESEND_API_KEY=
# 2) In alternativa SMTP (es. la casella aziendale). Usato solo se RESEND_API_KEY è vuota.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Facoltativo: la stessa richiesta in JSON al futuro gestionale interno.
QUOTE_WEBHOOK_URL=
# Facoltativo: file oltre 4 MB in totale caricati su Vercel Blob (Vercel → Storage → Blob).
BLOB_READ_WRITE_TOKEN=
